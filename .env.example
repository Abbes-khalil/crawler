# All settings are optional - the app runs with sensible local defaults.
APP_ENV=development
CRAWLER_USER_AGENT=ASBizDevCrawler/0.1
DEFAULT_MAX_PAGES=5
MAX_CRAWL_PAGES=20
REQUEST_TIMEOUT=15
REQUEST_RETRY_COUNT=1
RESPECT_ROBOTS_TXT=true
SITEMAP_MAX_URLS=200
PLAYWRIGHT_ENABLED=true
PLAYWRIGHT_MIN_CONTENT_CHARS=200
PLAYWRIGHT_TIMEOUT_MS=15000

# Local HTTP server. Loopback only; do not set HOST to 0.0.0.0.
HOST=127.0.0.1
PREFERRED_PORT=8765

# Defaults to a SQLite file under the per-user app-data directory.
# Override with a full SQLAlchemy URL (e.g. Postgres) if desired.
DATABASE_URL=

# Only needed when running the Next.js dev server against this backend.
FRONTEND_ORIGIN=http://localhost:3000,http://127.0.0.1:3000
